# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Postgres connection. Use "localhost" when running uvicorn on your machine;
# docker compose overrides this to point at the "db" service.
DATABASE_URL=postgresql+psycopg://chatapp:chatapp@localhost:5432/chatapp

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# "fake" = built-in echo bot (no API key, no cost). "google" = Gemini.
LLM_PROVIDER=fake
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
